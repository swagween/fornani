  "captains_log2385022345936914": {
    "series": [
      {
        "hide_portrait": true,
        "output": 0,
        "suite": [
          [
            {
              "message": "Captain's log: Oct. 29 entry: \"55 KT (headwind), ALT 6600. Looks to be smooth sailing. Whoever used to pilot this thing ran a tight ship. Not sure why there's a step-stool at the cockpit. I'm an Ooplo and even I don't need one of those...\""
            }
          ]
        ]
      }
    ]
  },
  "captains_log385022345609234": {
    "series": [
      {
        "hide_portrait": true,
        "output": 0,
        "suite": [
          [
            {
              "message": "Captain's log: Nov. 12 entry: \"We are headed straight for severe storm. Half the crew made a mad dash for the escape pods. Boss threw a fit and kicked the first mate overboard, pioneer style. This is my last entry... I'm sorry to the crew who were left behind.\""
            }
          ]
        ]
      }
    ]
